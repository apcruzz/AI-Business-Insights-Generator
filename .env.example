# Documentation only: python app.py does not load .env automatically.
# Local: export GROQ_API_KEY in your terminal; leave APP_ENV unset for Ollama.
GROQ_API_KEY=
# Hosted accounts (set in Render, never in Vite build variables):
APP_ENV=production
PUBLIC_ORIGIN=https://your-service.onrender.com
AUTH_MODE=accounts
# Persistent PostgreSQL; copy the real value privately from your database provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full&sslrootcert=system
ALLOW_REGISTRATION=true
# Legacy invited-demo option: AUTH_MODE=demo with DEMO_USERS_JSON generated by
# scripts/demo_users.py. Neither is needed for the new account flow.
# DEMO_USERS_JSON={}
# Render supplies PORT automatically. Docker/Gunicorn default: 10000.
PORT=10000
