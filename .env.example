# Documentation only: python app.py does not load .env automatically.
# Local: export GROQ_API_KEY in your terminal; leave APP_ENV unset for Ollama.
GROQ_API_KEY=
# Hosted demo (set in Render, never in Vite build variables):
APP_ENV=production
PUBLIC_ORIGIN=https://your-service.onrender.com
# Generate one hash per person using scripts/demo_users.py (no real values here).
DEMO_USERS_JSON={}
# Render supplies PORT automatically. Docker/Gunicorn default: 10000.
PORT=10000
